# ---------------------------------------------------------------------------
# support-agent — copy to `.env` and adjust. NEVER commit `.env`.
# Every value below has a safe default in code, so `docker compose up` works
# with this file absent (fake providers, no API keys needed). The passwords
# below are LOCAL DEVELOPMENT defaults only; replace them everywhere else.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- datastores ------------------------------------------------------------
# Postgres bootstrap (superuser, used only to create the two runtime roles).
POSTGRES_USER=support
POSTGRES_PASSWORD=support_local_pw
POSTGRES_DB=support

# Least-privilege roles created on first boot by
# deploy/postgres/init/10-roles.sh:
#   support_migrator -> owns the schema, may run DDL (Alembic only)
#   support_app      -> DML only, used by the API and the outbox worker
APP_DB_USER=support_app
APP_DB_PASSWORD=support_app_local_pw
MIGRATE_DB_USER=support_migrator
MIGRATE_DB_PASSWORD=support_migrator_local_pw

# The app connects as the DML-only role. Compose derives this from the values
# above; set it explicitly when running outside compose.
DATABASE_URL=postgresql+asyncpg://support_app:support_app_local_pw@postgres:5432/support
# Used by Alembic only (never by the API).
MIGRATE_DATABASE_URL=postgresql+asyncpg://support_migrator:support_migrator_local_pw@postgres:5432/support

# Redis is password-protected; the limiter must never be evicted.
REDIS_PASSWORD=support_redis_local_pw
REDIS_URL=redis://:support_redis_local_pw@redis:6379/0

# --- providers -------------------------------------------------------------
# LLM:     fake | openai | anthropic
# EMBEDDING: fake | openai  -- Anthropic serves chat but NOT embeddings, so this
# knob is separate from LLM_PROVIDER on purpose.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model output dimension. Changing this needs a new migration.
EMBEDDING_DIM=1536

# Only needed when the matching provider is selected. Leave empty for `fake`.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- identity / authorization ----------------------------------------------
# header: local-dev stub reading X-User-ID (spoofable; prod refuses to boot).
# oidc:   validate `Authorization: Bearer <JWT>` (signature via JWKS, iss, aud,
#         exp, sub). Enable the local IdP with:
#             docker compose --profile auth up -d keycloak
#         and set AUTH_MODE=oidc.
AUTH_MODE=header
OIDC_ISSUER=http://keycloak:8080/realms/support-agent
OIDC_AUDIENCE=support-agent-api
# Optional. Leave empty to discover `jwks_uri` from
#   <OIDC_ISSUER>/.well-known/openid-configuration
# (Keycloak publishes keys at .../protocol/openid-connect/certs, so a hardcoded
# /.well-known/jwks.json would be wrong). Set it only to pin a specific key set.
OIDC_JWKS_URI=
OIDC_LEEWAY_SECONDS=30
# Keycloak realm role that grants operator powers (empty disables role-based
# operators; the OPERATOR_IDS subject allowlist still applies).
OIDC_OPERATOR_ROLE=support-operator
# Comma-separated operator subject allowlist. Empty denies every decision by
# default. Prod requires at least one entry, AUTH_MODE=oidc, and
# ALLOW_ANON_OPERATORS=false.
OPERATOR_IDS=operator-1
ALLOW_ANON_OPERATORS=false

# --- escalation outbox worker ---------------------------------------------
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=2
OUTBOX_BATCH_SIZE=10
OUTBOX_STALE_SECONDS=120

# --- limits / budgets ------------------------------------------------------
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=3600
MAX_QUESTION_CHARS=2000
MAX_UPLOAD_BYTES=5242880
# Cap on embeddings one upload may cost; larger documents are rejected (413).
MAX_CHUNKS_PER_DOCUMENT=500
MAX_JSON_BYTES=1048576
MAX_OUTPUT_TOKENS=800

# --- retrieval -------------------------------------------------------------
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=300
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.15

# --- agent -----------------------------------------------------------------
AGENT_MAX_ITERATIONS=4
TOOL_TIMEOUT_SECONDS=8
TOOL_MAX_RETRIES=1

# --- observability ---------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=support-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLE_RATIO=1.0
PROVIDER_TIMEOUT_SECONDS=30
